# ============================================
# AI Student Assistant — Git Ignore Rules
# ============================================

# Dependencies
node_modules/
.npm

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment files (NEVER commit these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE specific files
.vscode/settings.json
.idea/
*.swp
*.swo

# TypeScript cache
*.tsbuildinfo

# Coverage reports
coverage/
.nyc_output

# Chrome extension unpacked build
extension/dist/

# Temporary files
*.tmp
*.temp


# Local environment overrides
.env.*
!.env.example

# Secrets and credentials
*.pem
*.key

# Editor and temporary files
.vscode/*
!.vscode/extensions.json