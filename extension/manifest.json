{
  "manifest_version": 3,
  "name": "AI Student Assistant",
  "version": "1.0.0",
  "description": "Your personal AI-powered academic assistant. Summarize, quiz, explain, and take notes — without leaving your browser.",

 "icons": {
  "16": "icons/icon16.svg",
  "32": "icons/icon32.svg",
  "48": "icons/icon48.svg",
  "128": "icons/icon128.svg"
},
"action": {
  "default_popup": "popup.html",
  "default_icon": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },

    "default_title": "AI Student Assistant — Click to open"
  },

  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/index.js"],
      "css": ["styles/sidebar.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "contextMenus"
  ],

  "host_permissions": [
    "http://localhost:5000/*",
    "https://*.googleapis.com/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "sidebar.html",
        "styles/*",
        "assets/*"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],

  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Toggle AI Assistant Sidebar"
    }
  }
}
